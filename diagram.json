{
  "version": 1,
  "author": "Candidato PNAAT",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-photoresistor-sensor", "id": "ldr1", "top": -50, "left": -150, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 50, "left": -150, "attrs": { "color": "green" } },
    { "type": "wokwi-led", "id": "led", "top": -50, "left": 150, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": -10, "left": 150, "attrs": { "value": "330" } }
