    [ "esp:D34", "ldr1:AO", "green", [ "v0" ] ],
    [ "esp:D2", "led:A", "red", [ "v0" ] ],
    [ "led:C", "r1:1", "black", [ "v0" ] ],
    [ "r1:2", "esp:GND.2", "black", [ "v0" ] ],
    [ "esp:D32", "btn1:1.l", "blue", [ "v0" ] ],
    [ "esp:GND.3", "btn1:2.l", "black", [ "v0" ] ]
  ]
